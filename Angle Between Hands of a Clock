class Solution {
    public double angleClock(int hour, int minutes) {
        // Minute hand moves 6 degrees per minute (360 degrees / 60 minutes)
        double minuteAngle = minutes * 6.0;
        
        // Hour hand moves 30 degrees per hour, plus a fraction based on minutes
        // (360 degrees / 12 hours = 30 degrees per hour)
        // Each minute also moves the hour hand by 0.5 degrees (30 degrees / 60 minutes)
        double hourAngle = (hour % 12) * 30.0 + minutes * 0.5;
        
        double diff = Math.abs(hourAngle - minuteAngle);
        
        // The angle between hands can be at most 360, but we want the smaller angle
        return Math.min(diff, 360.0 - diff);
    }
}
