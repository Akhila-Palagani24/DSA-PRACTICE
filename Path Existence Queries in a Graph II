
import java.util.*;

class Solution {
    public int[] pathExistenceQueries(int n, int[] nums, int maxDiff, int[][] queries) {

        int[][] arr = new int[n][2];
        for (int i = 0; i < n; i++) {
            arr[i][0] = nums[i];
            arr[i][1] = i;
        }

        Arrays.sort(arr, Comparator.comparingInt(a -> a[0]));

        int[] pos = new int[n];
        int[] comp = new int[n];

        int cid = 0;
        comp[arr[0][1]] = 0;
        pos[arr[0][1]] = 0;

        for (int i = 1; i < n; i++) {
            if (arr[i][0] - arr[i - 1][0] > maxDiff) {
                cid++;
            }
            comp[arr[i][1]] = cid;
            pos[arr[i][1]] = i;
        }

        int[] far = new int[n];
        int r = 0;
        for (int l = 0; l < n; l++) {
            if (r < l) r = l;
            while (r + 1 < n && arr[r + 1][0] - arr[l][0] <= maxDiff) {
                r++;
            }
            far[l] = r;
        }

        int LOG = 18; // 2^17 > 1e5
        int[][] up = new int[LOG][n];

        for (int i = 0; i < n; i++) {
            up[0][i] = far[i];
        }

        for (int k = 1; k < LOG; k++) {
            for (int i = 0; i < n; i++) {
                up[k][i] = up[k - 1][up[k - 1][i]];
            }
        }

        int[] ans = new int[queries.length];

        for (int qi = 0; qi < queries.length; qi++) {
            int u = queries[qi][0];
            int v = queries[qi][1];

            if (u == v) {
                ans[qi] = 0;
                continue;
            }

            if (comp[u] != comp[v]) {
                ans[qi] = -1;
                continue;
            }

            int a = pos[u];
            int b = pos[v];

            if (a > b) {
                int t = a;
                a = b;
                b = t;
            }

            int cur = a;
            int steps = 0;

            for (int k = LOG - 1; k >= 0; k--) {
                if (up[k][cur] < b) {
                    cur = up[k][cur];
                    steps += 1 << k;
                }
            }

            ans[qi] = steps + 1;
        }

        return ans;
    }
}
