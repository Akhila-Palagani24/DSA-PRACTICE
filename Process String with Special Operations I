#include <stdio.h>
#include <stdlib.h>
#include <limits.h>

int main(void) {
    int n;
    scanf("%d", &n);

    long long *strength      = malloc(n * sizeof(long long));
    int       *leftChild     = malloc(n * sizeof(int));
    int       *rightChild    = malloc(n * sizeof(int));
    long long *maxInSubtree  = malloc(n * sizeof(long long));
    int       *state         = calloc(n, sizeof(int)); // 0 = unvisited, 1 = children pushed
    int       *stack         = malloc((n + 5) * sizeof(int));
    int top = -1;

    for (int i = 0; i < n; i++) {
        scanf("%lld %d %d", &strength[i], &leftChild[i], &rightChild[i]);
    }

    stack[++top] = 0;
    int count = 0;

    while (top >= 0) {
        int node = stack[top];

        if (state[node] == 0) {
            state[node] = 1;
            if (leftChild[node]  != -1) stack[++top] = leftChild[node];
            if (rightChild[node] != -1) stack[++top] = rightChild[node];
        } else {
            top--; // pop node, it's fully processed now

            long long leftMax  = (leftChild[node]  == -1) ? LLONG_MIN : maxInSubtree[leftChild[node]];
            long long rightMax = (rightChild[node] == -1) ? LLONG_MIN : maxInSubtree[rightChild[node]];
            long long descendantMax = (leftMax > rightMax) ? leftMax : rightMax;

            if (strength[node] > descendantMax) count++;

            maxInSubtree[node] = (strength[node] > descendantMax) ? strength[node] : descendantMax;
        }
    }

    printf("%d\n", count);

    free(strength);
    free(leftChild);
    free(rightChild);
    free(maxInSubtree);
    free(state);
    free(stack);

    return 0;
}
