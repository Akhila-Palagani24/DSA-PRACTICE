class Solution {
    static class Fenwick {
        int[] bit;

        Fenwick(int n) {
            bit = new int[n + 2];
        }

        void add(int idx, int val) {
            while (idx < bit.length) {
                bit[idx] += val;
                idx += idx & -idx;
            }
        }

        int sum(int idx) {
            int res = 0;
            while (idx > 0) {
                res += bit[idx];
                idx -= idx & -idx;
            }
            return res;
        }
    }

    public long countMajoritySubarrays(int[] nums, int target) {
        int n = nums.length;

        // Prefix sums are in [-n, n]
        int offset = n + 1;
        Fenwick fw = new Fenwick(2 * n + 5);

        long ans = 0;
        int prefix = 0;

        // Initial prefix sum = 0
        fw.add(offset + 1, 1);

        for (int x : nums) {
            if (x == target)
                prefix++;
            else
                prefix--;

            int idx = prefix + offset + 1;

            // Count previous prefix sums strictly smaller than current
            ans += fw.sum(idx - 1);

            fw.add(idx, 1);
        }

        return ans;
    }
}
